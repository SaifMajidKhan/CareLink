# Never commit a real .env file or database password.
# Local demonstration database:
# DATABASE_URL=sqlite:///./carelink-demo.db

# Hosted PostgreSQL example. Copy the actual connection string from the host.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Exact HTTPS addresses allowed to use the API, separated by commas.
# Add the deployed portal address here after it exists.
# CORS_ORIGINS=https://your-portal.example.com
