# Never commit a real .env file or database password.
# Local demonstration database:
# DATABASE_URL=sqlite:///./carelink-demo.db

# Neon CLI writes DATABASE_URL and DATABASE_URL_UNPOOLED into the repository's
# ignored .env.local file. The backend loads that file automatically.
# Process settings (such as Render environment variables) take priority.
# Plain postgresql:// provider URLs are accepted with the installed psycopg driver.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require

# Exact HTTPS addresses allowed to use the API, separated by commas.
# Add the deployed portal address here after it exists.
# CORS_ORIGINS=https://your-portal.example.com
